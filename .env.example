# Copy to .env.local for local testing. On Vercel, add each one under Settings > Environment Variables.
# NEVER commit the real values to GitHub.

# --- Supabase (needed for photos, Catch of the Day, videos, admin, reservations) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- Admin login ---
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=any-long-random-string
SITE_URL=https://your-project.vercel.app

# --- Needed only when you take real reservations ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=bookings@your-domain.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1XXXXXXXXXX
CRON_SECRET=another-long-random-string

# Fallbacks only. The alert phone and email are changed in /admin/settings.
OWNER_PHONE=+18503629295
OWNER_EMAIL=anchormanagementfishingcharter@gmail.com
